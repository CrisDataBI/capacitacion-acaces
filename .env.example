# Copiar este archivo como ".env" y completar con los valores reales.
# El archivo ".env" real NUNCA debe compartirse ni subirse a ningun repositorio.

# Supabase > tu proyecto > Connect > "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://usuario:password@host:6543/postgres

# Cadena larga y aleatoria para firmar las sesiones. Ejemplo para generarla:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

PORT=3000
